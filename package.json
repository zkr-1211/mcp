{
  "name": "postar-pipe-mcp",
  "version": "1.4.2",
  "description": "Unified CI/CD MCP Server - orchestrates GitLab and Jenkins MCPs with dynamic skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkr-1211/mcp"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "postar-pipe-mcp": "bin/postar-pipe-mcp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run copy:skills",
    "build:tsc": "tsc && npm run copy:skills",
    "copy:skills": "cp -r src/skills dist/",
    "dev": "vite",
    "start": "node dist/server.js",
    "postinstall": "node bin/install.js",
    "pkg:build": "npm run build && npx @yao-pkg/pkg dist/server.js -t node24-macos-arm64 -o release/postar-pipe-mcp-macos-arm64 --compress Brotli --config package.json",
    "release": "npm version patch && git push && git push --tags && npm run watch:release",
    "release:minor": "npm version minor && git push && git push --tags && npm run watch:release",
    "release:major": "npm version major && git push && git push --tags && npm run watch:release",
    "watch:release": "node scripts/watch-release.js",
    "npm:publish": "gh workflow run publish.yml -f version=$(node -p \"require('./package.json').version\")"
  },
  "keywords": [
    "mcp",
    "ci",
    "cd",
    "gitlab",
    "jenkins"
  ],
  "author": "zhangkr",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "gitlab-core-mcp": "^6.62.2",
    "jenkins-mcp": "^0.2.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@yao-pkg/pkg": "^6.14.2",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-node": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "entry": "dist/server.js",
    "scripts": [
      "dist/**/*.js",
      "node_modules/@modelcontextprotocol/sdk/**/*.js",
      "node_modules/gitlab-core-mcp/**/*.js",
      "node_modules/jenkins-mcp/**/*.js"
    ],
    "assets": [
      "dist/skills/**/*",
      "node_modules/gitlab-core-mcp/**/*.js",
      "node_modules/gitlab-core-mcp/**/*.json",
      "node_modules/jenkins-mcp/**/*.js",
      "node_modules/jenkins-mcp/**/*.json"
    ],
    "targets": [
      "node24-macos-arm64",
      "node24-win-x64"
    ],
    "outputPath": "release"
  }
}
