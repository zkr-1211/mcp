{
  "name": "postar-pipe-mcp",
  "version": "1.1.14",
  "description": "Unified CI/CD MCP Server - orchestrates GitLab and Jenkins MCPs with dynamic skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkr-1211/mcp"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "postar-pipe-mcp": "dist/server.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run copy:skills",
    "build:tsc": "tsc && npm run copy:skills",
    "copy:skills": "cp -r src/skills dist/",
    "dev": "vite",
    "start": "node dist/server.js",
    "postinstall": "node bin/install.js",
    "pkg:build": "npm run build && pkg . -t node24-macos-arm64",
    "release": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "keywords": [
    "mcp",
    "ci",
    "cd",
    "gitlab",
    "jenkins"
  ],
  "author": "zhangkr",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "gitlab-core-mcp": "^6.62.1",
    "jenkins-mcp": "^0.2.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-node": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "node_modules/gitlab-core-mcp/**/*.js",
      "node_modules/jenkins-mcp/**/*.js"
    ],
    "assets": [
      "dist/skills/**/*",
      "node_modules/gitlab-core-mcp/**/*.js",
      "node_modules/gitlab-core-mcp/**/*.json",
      "node_modules/jenkins-mcp/**/*.js",
      "node_modules/jenkins-mcp/**/*.json"
    ],
    "targets": [
      "node24-macos-arm64",
      "node24-macos-x64",
      "node24-linux-x64",
      "node24-win-x64"
    ],
    "outputPath": "release"
  }
}
